OLLAMA_BASE_URL=http://localhost:12000
OLLAMA_LLM_MODEL=qwen2.5:32b
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_ENABLE_EMBEDDING_RETRIEVAL=1
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=8192
# Docker-hosted Streamable HTTP QGIS MCP service. Leave blank to use local GIS-tool fallback only.
QGIS_MCP_SERVER_URL=http://127.0.0.1:9877/mcp
ALLOW_STANDARD_LIBRARY_EDIT=0
APP_HOST=127.0.0.1
APP_PORT=8010

# QGIS 原生渲染预览。FastAPI 仍运行在 ziketi3 环境，地图图片由 Docker 中的 QGIS Server 渲染。
# 用户上传的 GIS 文件会同步到 QGIS_SERVER_DATA_ROOT_HOST，再按每个网页项目生成或选择 QGIS 工程。
QGIS_SERVER_URL=http://127.0.0.1:8080/ows/
QGIS_PROJECT_FILE=E:\QGIS_Server\projects\projects_001\PushPK_Dreieich Mitte_Handwerk.qgz
QGIS_PROJECT_FILE_CONTAINER=/io/data/projects_001/PushPK_Dreieich Mitte_Handwerk.qgz
QGIS_SERVER_DATA_ROOT_HOST=E:\QGIS_Server\projects
QGIS_SERVER_DATA_ROOT_CONTAINER=/io/data
QGIS_DOCKER_IMAGE=qgis/qgis-server:ltr
QGIS_PREVIEW_CRS=EPSG:25832
QGIS_SERVER_TIMEOUT=20
QGIS_PREVIEW_EXCLUDE_LAYERS=OpenStreetMap-DE,Liegenschaftskarte,Liegenschaftskarte Graustufen
